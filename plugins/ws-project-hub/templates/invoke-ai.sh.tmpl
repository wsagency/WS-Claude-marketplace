#!/usr/bin/env bash
# WS.agency Invoke AI — project hub launcher
# Auto-generated by ws-project-hub. Re-run /ws-hub-init or /ws-hub-add-repo to regenerate.

set -euo pipefail

HUB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG="$HUB_DIR/project.yaml"
MARKETPLACE_URL="${WS_MARKETPLACE_URL:-https://github.com/wsagency/ws-claude-marketplace.git}"
MARKETPLACE_CACHE="$HOME/.cache/ws-hub"
ANIM_SECONDS="${WS_HUB_ANIM_SECONDS:-3}"

if [[ ! -f "$CONFIG" ]]; then
  echo "error: $CONFIG not found" >&2
  exit 1
fi

# ─── yaml helpers ──────────────────────────────────────────────────────────
yaml_scalar() {
  awk -v key="$1" '
    /^project:/ {inproj=1; next}
    inproj && /^[^[:space:]]/ {inproj=0}
    inproj && $1 == key":" {
      sub(/^[[:space:]]*[^:]+:[[:space:]]*/,"")
      sub(/[[:space:]]+#.*$/,"")
      gsub(/^"|"$/,"")
      gsub(/^'\''|'\''$/,"")
      print; exit
    }
  ' "$CONFIG"
}

yaml_repos_field() {
  awk -v key="$1" '
    /^repos:/ {inrepos=1; next}
    inrepos && /^[^[:space:]-]/ {inrepos=0}
    inrepos {
      if (match($0, "^[[:space:]]*-?[[:space:]]*" key ":[[:space:]]*")) {
        val = substr($0, RSTART + RLENGTH)
        sub(/[[:space:]]+#.*$/, "", val)
        gsub(/^"|"$/, "", val)
        gsub(/^'\''|'\''$/, "", val)
        print val
      }
    }
  ' "$CONFIG"
}

PROJECT_NAME="$(yaml_scalar name)"
PROJECT_DESC="$(yaml_scalar description)"
TMUX_SESSION="$(yaml_scalar session)"
: "${TMUX_SESSION:=${PROJECT_NAME}-hub}"

# Portable array fill (macOS ships bash 3.2 — no `mapfile`/`readarray`)
REPO_NAMES=(); while IFS= read -r line; do REPO_NAMES+=("$line"); done < <(yaml_repos_field name)
REPO_PATHS=(); while IFS= read -r line; do REPO_PATHS+=("$line"); done < <(yaml_repos_field path)
REPO_DESCS=(); while IFS= read -r line; do REPO_DESCS+=("$line"); done < <(yaml_repos_field description)
REPO_TECHS=(); while IFS= read -r line; do REPO_TECHS+=("$line"); done < <(yaml_repos_field tech)

# ─── colors ────────────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
  R=$'\033[0m'; DIM=$'\033[2m'; B=$'\033[1m'
  BLUE=$'\033[34m'; CYAN=$'\033[36m'; YEL=$'\033[93m'
  GRN=$'\033[32m'; MAG=$'\033[35m'; WHT=$'\033[97m'
else
  R=""; DIM=""; B=""; BLUE=""; CYAN=""; YEL=""; GRN=""; MAG=""; WHT=""
fi

# ─── earth frames (4 rotation phases) ──────────────────────────────────────
earth() {
  case $(( $1 % 4 )) in
    0) cat <<EOF
${BLUE}   .--""--.${R}
${BLUE}  /${GRN} .--..${BLUE}  \\${R}
${BLUE} | ${GRN}(  ##)${BLUE} ) |${R}
${BLUE} |  ${GRN}\`--' ${BLUE}/  |${R}
${BLUE}  \\${GRN}  ##  ${BLUE}/${R}
${BLUE}   '----'${R}
EOF
    ;;
    1) cat <<EOF
${BLUE}   .--""--.${R}
${BLUE}  /  ${GRN}.--.${BLUE} .\\${R}
${BLUE} | ${GRN}(  ##)${BLUE}) |${R}
${BLUE} |  ${GRN}'--' ${BLUE}/  |${R}
${BLUE}  \\ ${GRN} ## ${BLUE} /${R}
${BLUE}   '----'${R}
EOF
    ;;
    2) cat <<EOF
${BLUE}   .--""--.${R}
${BLUE}  /   ${GRN}.--.${BLUE}\\${R}
${BLUE} |  ${GRN}(##  )${BLUE} |${R}
${BLUE} |   ${GRN}'--'${BLUE} /|${R}
${BLUE}  \\  ${GRN}##  ${BLUE}/${R}
${BLUE}   '----'${R}
EOF
    ;;
    3) cat <<EOF
${BLUE}   .--""--.${R}
${BLUE}  / ${GRN}..--..${BLUE} \\${R}
${BLUE} |${GRN}(  ## )${BLUE}  |${R}
${BLUE} | ${GRN}\`--'${BLUE}   /|${R}
${BLUE}  \\${GRN} ##  ${BLUE} /${R}
${BLUE}   '----'${R}
EOF
    ;;
  esac
}

draw_atlas() {
  local frame=$1 flash=$2
  local L="  " RR="  "
  if [[ $flash -eq 1 ]]; then L="${YEL}${B}\\\\${R}"; RR="${YEL}${B}//${R}"
  elif [[ $flash -eq 2 ]]; then L="${YEL}${B}/${R} "; RR=" ${YEL}${B}\\\\${R}"
  fi
  echo
  printf '          %b          %b\n' "$L" "$RR"
  while IFS= read -r line; do
    printf '       %b\n' "$line"
  done < <(earth "$frame")
  printf '         %b\\   /%b\n' "$L" "$RR"
  printf '           \\ /\n'
  printf '            %bO%b\n' "$WHT" "$R"
  printf '           /|\\\n'
  printf '            |\n'
  printf '           / \\\n'
  printf '          /   \\\n'
}

typewriter() {
  local text="$1" delay="${2:-0.012}" i
  for ((i=0; i<${#text}; i++)); do
    printf '%s' "${text:$i:1}"
    sleep "$delay"
  done
  printf '\n'
}

animate_intro() {
  local end=$(( $(date +%s) + ANIM_SECONDS ))
  local frame=0
  tput civis 2>/dev/null || true
  trap 'tput cnorm 2>/dev/null || true; clear 2>/dev/null || true' EXIT INT TERM

  clear
  printf '\n  '
  typewriter "${B}${CYAN}WS.agency${R} ${DIM}»${R} ${B}INVOKE AI${R} ${DIM}for${R} ${B}${MAG}${PROJECT_NAME}${R}"

  while [[ $(date +%s) -lt $end ]]; do
    tput cup 3 0 2>/dev/null || printf '\n'
    local flash=0
    (( RANDOM % 4 == 0 )) && flash=$(( (RANDOM % 2) + 1 ))
    draw_atlas "$frame" "$flash"
    frame=$((frame + 1))
    sleep 0.18
  done
  tput cnorm 2>/dev/null || true
  trap - EXIT INT TERM
  clear
}

# ─── post-intro: project + repos summary ───────────────────────────────────
ADD_DIR_ARGS=()

print_summary() {
  printf '\n  %b%bWS.agency%b %b»%b %bINVOKE AI%b %bfor%b %b%b%s%b\n' \
    "$B" "$CYAN" "$R" "$DIM" "$R" "$B" "$R" "$DIM" "$R" "$B" "$MAG" "$PROJECT_NAME" "$R"
  printf '  %b%s%b\n\n' "$DIM" "$PROJECT_DESC" "$R"
  printf '  %bRepositories:%b\n' "$B" "$R"

  local n=${#REPO_NAMES[@]} i
  for ((i=0; i<n; i++)); do
    local name="${REPO_NAMES[$i]:-?}"
    local rel="${REPO_PATHS[$i]:-}"
    local desc="${REPO_DESCS[$i]:-}"
    local tech="${REPO_TECHS[$i]:-}"
    local abs=""
    [[ -n "$rel" ]] && abs="$(cd "$HUB_DIR" && cd "$rel" 2>/dev/null && pwd || true)"
    if [[ -n "$abs" && -d "$abs" ]]; then
      ADD_DIR_ARGS+=(--add-dir "$abs")
      printf '    %b✓%b %b%-22s%b %b%s%b\n' "$GRN" "$R" "$B" "$name" "$R" "$DIM" "$desc" "$R"
    else
      printf '    %b⊘ %-22s %s%b\n' "$DIM" "$name" "$desc" "$R"
    fi
    [[ -n "$tech" ]] && printf '      %btech:%b %s\n' "$DIM" "$R" "$tech"
  done
  echo
}

# ─── marketplace check ─────────────────────────────────────────────────────
check_marketplace() {
  mkdir -p "$MARKETPLACE_CACHE"
  local seen_file="$MARKETPLACE_CACHE/known-marketplace-sha"
  local remote_sha=""
  remote_sha="$(git ls-remote "$MARKETPLACE_URL" HEAD 2>/dev/null | awk '{print $1}' || true)"
  if [[ -z "$remote_sha" ]]; then
    printf '  %b!%b could not reach marketplace at %b%s%b (offline?)\n' "$YEL" "$R" "$DIM" "$MARKETPLACE_URL" "$R"
    return
  fi
  local known_sha=""
  [[ -f "$seen_file" ]] && known_sha="$(cat "$seen_file")"
  if [[ -z "$known_sha" ]]; then
    printf '  %b!%b first launch — if ws-marketplace is not added yet, run inside claude:\n' "$YEL" "$R"
    printf '      %b/plugin marketplace add wsagency/ws-claude-marketplace%b\n' "$B" "$R"
  elif [[ "$known_sha" != "$remote_sha" ]]; then
    printf '  %b↑%b marketplace update available %b(%s → %s)%b\n' "$YEL" "$R" "$DIM" "${known_sha:0:7}" "${remote_sha:0:7}" "$R"
    printf '      run inside claude: %b/plugin marketplace update ws-marketplace%b\n' "$B" "$R"
  else
    printf '  %b✓%b marketplace up to date %b(%s)%b\n' "$GRN" "$R" "$DIM" "${remote_sha:0:7}" "$R"
  fi
  echo "$remote_sha" > "$seen_file"
}

# ─── tmux handling ─────────────────────────────────────────────────────────
launch() {
  local claude_cmd=(claude --dangerously-skip-permissions "${ADD_DIR_ARGS[@]}" "$@")

  if [[ -n "${TMUX:-}" ]]; then
    cd "$HUB_DIR"
    exec "${claude_cmd[@]}"
  fi

  if ! command -v tmux >/dev/null 2>&1; then
    printf '  %btmux not installed — running without persistent session%b\n' "$DIM" "$R"
    cd "$HUB_DIR"
    exec "${claude_cmd[@]}"
  fi

  local session="$TMUX_SESSION"
  if tmux has-session -t "$session" 2>/dev/null; then
    printf '\n  %btmux session "%s" already exists%b\n' "$YEL" "$session" "$R"
    printf '    [%ba%b]ttach  [%bn%b]ew session with suffix  [%bc%b]ancel: ' "$B" "$R" "$B" "$R" "$B" "$R"
    read -r choice
    case "$choice" in
      a|A|"") exec tmux attach -t "$session" ;;
      n|N)
        local i=2
        while tmux has-session -t "${session}-${i}" 2>/dev/null; do i=$((i+1)); done
        session="${session}-${i}"
        ;;
      *) printf '  cancelled\n'; exit 0 ;;
    esac
  fi

  local cmd_str
  cmd_str=$(printf '%q ' "${claude_cmd[@]}")
  exec tmux new-session -s "$session" -c "$HUB_DIR" "bash -c $(printf '%q' "$cmd_str")"
}

# ─── main ──────────────────────────────────────────────────────────────────
animate_intro
print_summary
check_marketplace
printf '\n  %bpress ENTER to launch Claude…%b ' "$DIM" "$R"
read -r _
launch "$@"
