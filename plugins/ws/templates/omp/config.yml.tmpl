# WS hub preset for omp — written by /ws-hub init (project-level .omp/config.yml)
# Layered over ~/.omp/agent/config.yml; arrays REPLACE wholesale.
# Init ASKS about each block below — defaults: yolo approval, guards OFF.

# Approval posture. WS default = omp default = yolo (agent runs freely).
# Uncomment for cautious client repos:
# tools:
#   approvalMode: write

# Bash guardrails (OPTIONAL, default off). These act at the APPROVAL layer —
# a matching command is denied/prompted before it executes. The TTSR rules in
# .omp/rules/ interrupt even earlier (mid-stream). Enable if this repo is
# high-stakes:
# bash:
#   patterns:
#     - { match: "git push*--force*", approval: deny }
#     - { match: "rm -rf *", approval: prompt }

# Compact a bit earlier on hub work (cross-repo sessions run long).
compaction:
  thresholdPercent: 80

# ── Model roles — PER PROJECT (this file), so each project can run different
# providers/models. omp has 10 FIXED role keys (no arbitrary custom names);
# per-purpose "custom roles" are done via task.agentModelOverrides below.
# Thinking level suffix: :low | :medium | :high (append to any model).
# Fill with the models this project uses — WS class mapping:
# modelRoles:
#   default: <daily coding — e.g. anthropic/claude-sonnet-5:medium>
#   slow:    <hardest reasoning — e.g. anthropic/claude-opus-5:high or claude-fable-5:high>
#   plan:    <specs & maps — e.g. anthropic/claude-opus-5:medium>
#   task:    <subagent workers — e.g. anthropic/claude-sonnet-5 or composer-2.5-fast>
#   smol:    <fast/cheap tier — e.g. google/gemini-3.6-flash:low>
#   tiny:    <titles/classify — same as smol>
#   commit:  <commit messages — cheap, e.g. google/gemini-3.6-flash:low>
#   vision:  <screenshots/UI — e.g. google/gemini-3.5-pro>
#   designer: <UI prototypes — e.g. anthropic/claude-sonnet-5>
#   advisor: <CROSS-FAMILY reviewer — different vendor than default!
#             e.g. xai/grok-4.5:medium or google/gemini-3.5-pro:medium>

# Per-spawn effort is schema-gated in omp 17.1.6+ (default off). Enable it so
# WS skills can select lo/med/hi reasoning independently of the agent's model
# role. Omit this block on omp 17.1.5.
task:
  enableEffort: true

  # Per-agent "custom roles" — pin specific models to WS worker agents. The
  # values below MIRROR the role each agent already declares in its shipped
  # frontmatter (generated in extensions/omp-ws), so this block stays commented:
  # uncomment ONLY to deviate — e.g. pin `researcher` to a long-context model.
  # A value is either a role ref ("@role") or a literal model id;
  # agentModelOverrides outranks shipped frontmatter.
  # agentModelOverrides:
  #   # @slow — deepest judgement.
  #   reviewer: "@slow"
  #   # @plan — architecture and spec maps.
  #   hub-architect: "@plan"
  #   architecture-documenter: "@plan"
  #   # @task — skilled workers that write or synthesise.
  #   researcher: "@task"
  #   tdd-runner: "@task"
  #   adr-writer: "@task"
  #   diataxis-writer: "@task"
  #   release-notes-writer: "@task"
  #   api-documenter: "@task"
  #   # @smol — mechanical scan/extract jobs.
  #   changelog-analyzer: "@smol"
  #   contributing-generator: "@smol"
  #   public-api-watcher: "@smol"
  #   arch-watcher: "@smol"
  #   # @tiny — pure classification.
  #   docs-doctor: "@tiny"
