#!/usr/bin/env bash
# WS.agency Invoke AI — project hub launcher
# Auto-generated by the ws plugin. Re-run /ws-hub init or /ws-hub add to regenerate.

set -euo pipefail

HUB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG="$HUB_DIR/project.yaml"
MARKETPLACE_URL="${WS_MARKETPLACE_URL:-https://github.com/wsagency/ws-claude-marketplace.git}"
HUB_CACHE="$HOME/.cache/ws-hub"
LAST_AGENT_FILE="$HUB_CACHE/last-agent"
ANIM_SECONDS="${WS_HUB_ANIM_SECONDS:-3}"

if [[ ! -f "$CONFIG" ]]; then
  echo "error: $CONFIG not found" >&2
  exit 1
fi

# ─── agent registry ────────────────────────────────────────────────────────
# add new agents here: append the name to REGISTERED_AGENTS and define an
# agent_cmd_<name>() function that fills AGENT_CMD with the launch command.
REGISTERED_AGENTS=(claude omp)
AGENT_CMD=()

agent_cmd_claude() {
  AGENT_CMD=(claude --dangerously-skip-permissions ${ADD_DIR_ARGS[@]+"${ADD_DIR_ARGS[@]}"})
}

agent_cmd_omp() {
  # omp has no add-dir equivalent — plain launch at the hub root.
  # Sibling-pathed (../) repos are unreachable in omp.
  AGENT_CMD=(omp)
}

agent_registered() {
  local a
  for a in "${REGISTERED_AGENTS[@]}"; do
    [[ "$a" == "$1" ]] && return 0
  done
  return 1
}

# ─── argument parsing ──────────────────────────────────────────────────────
# --agent <name> is parsed and consumed only BEFORE a literal `--`.
# Everything after `--` is forwarded verbatim to the chosen agent's command
# and is agent-specific (e.g. `-- --resume` is a claude arg).
AGENT_CHOICE="${WS_HUB_AGENT:-}"
FORWARD_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --)
      shift
      FORWARD_ARGS=("$@")
      break
      ;;
    --agent)
      if [[ $# -lt 2 ]]; then
        echo "error: --agent requires a name (registered agents: ${REGISTERED_AGENTS[*]})" >&2
        exit 1
      fi
      AGENT_CHOICE="$2"
      shift 2
      ;;
    *)
      echo "usage: ./invoke-ai.sh [--agent <name>] [-- <agent-specific args>]" >&2
      echo "error: unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

if [[ -n "$AGENT_CHOICE" ]] && ! agent_registered "$AGENT_CHOICE"; then
  echo "error: unknown agent '$AGENT_CHOICE' (registered agents: ${REGISTERED_AGENTS[*]})" >&2
  exit 1
fi

# ─── yaml helpers ──────────────────────────────────────────────────────────
yaml_scalar() {
  awk -v key="$1" '
    /^project:/ {inproj=1; next}
    inproj && /^[^[:space:]]/ {inproj=0}
    inproj && $1 == key":" {
      sub(/^[[:space:]]*[^:]+:[[:space:]]*/,"")
      sub(/[[:space:]]+#.*$/,"")
      gsub(/^"|"$/,"")
      gsub(/^'\''|'\''$/,"")
      print; exit
    }
  ' "$CONFIG"
}

# Emits exactly ONE line per repo entry (empty when the key is absent), so the
# by-index arrays below stay aligned even when optional fields are missing.
# Entries are split on `- ` boundaries (the `- name:` line starts a new entry).
yaml_repos_field() {
  awk -v key="$1" '
    function emit() { if (started) print val }
    /^repos:/ {inrepos=1; next}
    inrepos && /^[^[:space:]-]/ {emit(); started=0; inrepos=0}
    !inrepos {next}
    /^[[:space:]]*-([[:space:]]|$)/ {emit(); started=1; val=""}
    started {
      if (match($0, "^[[:space:]]*-?[[:space:]]*" key ":[[:space:]]*")) {
        val = substr($0, RSTART + RLENGTH)
        sub(/[[:space:]]+#.*$/, "", val)
        gsub(/^"|"$/, "", val)
        gsub(/^'\''|'\''$/, "", val)
      }
    }
    END {emit()}
  ' "$CONFIG"
}

PROJECT_NAME="$(yaml_scalar name)"
PROJECT_DESC="$(yaml_scalar description)"
TMUX_SESSION="$(yaml_scalar session)"
: "${TMUX_SESSION:=${PROJECT_NAME}-hub}"

# Portable array fill (macOS ships bash 3.2 — no `mapfile`/`readarray`)
REPO_NAMES=(); while IFS= read -r line; do REPO_NAMES+=("$line"); done < <(yaml_repos_field name)
REPO_PATHS=(); while IFS= read -r line; do REPO_PATHS+=("$line"); done < <(yaml_repos_field path)
REPO_DESCS=(); while IFS= read -r line; do REPO_DESCS+=("$line"); done < <(yaml_repos_field description)
REPO_TECHS=(); while IFS= read -r line; do REPO_TECHS+=("$line"); done < <(yaml_repos_field tech)

# ─── colors ────────────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
  R=$'\033[0m'; DIM=$'\033[2m'; B=$'\033[1m'
  BLUE=$'\033[34m'; CYAN=$'\033[36m'; YEL=$'\033[93m'
  GRN=$'\033[32m'; MAG=$'\033[35m'; WHT=$'\033[97m'
else
  R=""; DIM=""; B=""; BLUE=""; CYAN=""; YEL=""; GRN=""; MAG=""; WHT=""
fi

# ─── earth frames (4 rotation phases) ──────────────────────────────────────
earth() {
  case $(( $1 % 4 )) in
    0) cat <<EOF
${BLUE}   .--""--.${R}
${BLUE}  /${GRN} .--..${BLUE}  \\${R}
${BLUE} | ${GRN}(  ##)${BLUE} ) |${R}
${BLUE} |  ${GRN}\`--' ${BLUE}/  |${R}
${BLUE}  \\${GRN}  ##  ${BLUE}/${R}
${BLUE}   '----'${R}
EOF
    ;;
    1) cat <<EOF
${BLUE}   .--""--.${R}
${BLUE}  /  ${GRN}.--.${BLUE} .\\${R}
${BLUE} | ${GRN}(  ##)${BLUE}) |${R}
${BLUE} |  ${GRN}'--' ${BLUE}/  |${R}
${BLUE}  \\ ${GRN} ## ${BLUE} /${R}
${BLUE}   '----'${R}
EOF
    ;;
    2) cat <<EOF
${BLUE}   .--""--.${R}
${BLUE}  /   ${GRN}.--.${BLUE}\\${R}
${BLUE} |  ${GRN}(##  )${BLUE} |${R}
${BLUE} |   ${GRN}'--'${BLUE} /|${R}
${BLUE}  \\  ${GRN}##  ${BLUE}/${R}
${BLUE}   '----'${R}
EOF
    ;;
    3) cat <<EOF
${BLUE}   .--""--.${R}
${BLUE}  / ${GRN}..--..${BLUE} \\${R}
${BLUE} |${GRN}(  ## )${BLUE}  |${R}
${BLUE} | ${GRN}\`--'${BLUE}   /|${R}
${BLUE}  \\${GRN} ##  ${BLUE} /${R}
${BLUE}   '----'${R}
EOF
    ;;
  esac
}

draw_atlas() {
  local frame=$1 flash=$2
  local L="  " RR="  "
  if [[ $flash -eq 1 ]]; then L="${YEL}${B}\\\\${R}"; RR="${YEL}${B}//${R}"
  elif [[ $flash -eq 2 ]]; then L="${YEL}${B}/${R} "; RR=" ${YEL}${B}\\\\${R}"
  fi
  echo
  printf '          %b          %b\n' "$L" "$RR"
  while IFS= read -r line; do
    printf '       %b\n' "$line"
  done < <(earth "$frame")
  printf '         %b\\   /%b\n' "$L" "$RR"
  printf '           \\ /\n'
  printf '            %bO%b\n' "$WHT" "$R"
  printf '           /|\\\n'
  printf '            |\n'
  printf '           / \\\n'
  printf '          /   \\\n'
}

typewriter() {
  local text="$1" delay="${2:-0.012}" i
  for ((i=0; i<${#text}; i++)); do
    printf '%s' "${text:$i:1}"
    sleep "$delay"
  done
  printf '\n'
}

animate_intro() {
  local end=$(( $(date +%s) + ANIM_SECONDS ))
  local frame=0
  tput civis 2>/dev/null || true
  trap 'tput cnorm 2>/dev/null || true; clear 2>/dev/null || true' EXIT INT TERM

  clear 2>/dev/null || true
  printf '\n  '
  typewriter "${B}${CYAN}WS.agency${R} ${DIM}»${R} ${B}INVOKE AI${R} ${DIM}for${R} ${B}${MAG}${PROJECT_NAME}${R}"

  while [[ $(date +%s) -lt $end ]]; do
    tput cup 3 0 2>/dev/null || printf '\n'
    local flash=0
    (( RANDOM % 4 == 0 )) && flash=$(( (RANDOM % 2) + 1 ))
    draw_atlas "$frame" "$flash"
    frame=$((frame + 1))
    sleep 0.18
  done
  tput cnorm 2>/dev/null || true
  trap - EXIT INT TERM
  clear 2>/dev/null || true
}

# ─── agent pick (runs BEFORE the summary — mounts depend on the agent) ─────
pick_agent() {
  local default_agent="claude" pick i name
  if [[ -f "$LAST_AGENT_FILE" ]]; then
    default_agent="$(cat "$LAST_AGENT_FILE" 2>/dev/null || true)"
    agent_registered "$default_agent" || default_agent="claude"
  fi

  printf '\n  %bAgents:%b\n' "$B" "$R"
  for ((i=0; i<${#REGISTERED_AGENTS[@]}; i++)); do
    name="${REGISTERED_AGENTS[$i]}"
    if [[ "$name" == "$default_agent" ]]; then
      printf '    %b%d%b) %b%s%b %b(default)%b\n' "$B" "$((i+1))" "$R" "$B" "$name" "$R" "$DIM" "$R"
    else
      printf '    %b%d%b) %s\n' "$B" "$((i+1))" "$R" "$name"
    fi
  done
  printf '  %bpick an agent [ENTER = %s]:%b ' "$DIM" "$default_agent" "$R"
  read -r pick
  if [[ -z "$pick" ]]; then
    AGENT_CHOICE="$default_agent"
  elif [[ "$pick" =~ ^[0-9]+$ ]] && (( pick >= 1 && pick <= ${#REGISTERED_AGENTS[@]} )); then
    AGENT_CHOICE="${REGISTERED_AGENTS[$((pick-1))]}"
  elif agent_registered "$pick"; then
    AGENT_CHOICE="$pick"
  else
    echo "error: unknown agent '$pick' (registered agents: ${REGISTERED_AGENTS[*]})" >&2
    exit 1
  fi
}

persist_agent_choice() {
  mkdir -p "$HUB_CACHE"
  echo "$AGENT_CHOICE" > "$LAST_AGENT_FILE"
}

# ─── mounts (decoupled from the summary rendering) ─────────────────────────
ADD_DIR_ARGS=()
REPO_ABS=()

build_mounts() {
  local n=${#REPO_NAMES[@]} i rel abs
  for ((i=0; i<n; i++)); do
    rel="${REPO_PATHS[$i]:-}"
    abs=""
    [[ -n "$rel" ]] && abs="$(cd "$HUB_DIR" && cd "$rel" 2>/dev/null && pwd || true)"
    REPO_ABS[$i]="$abs"
    if [[ -n "$abs" && -d "$abs" ]]; then
      ADD_DIR_ARGS+=(--add-dir "$abs")
    fi
  done
}

# ─── project + repos summary (reachability per chosen agent) ───────────────
print_summary() {
  printf '\n  %b%bWS.agency%b %b»%b %bINVOKE AI%b %bfor%b %b%b%s%b\n' \
    "$B" "$CYAN" "$R" "$DIM" "$R" "$B" "$R" "$DIM" "$R" "$B" "$MAG" "$PROJECT_NAME" "$R"
  printf '  %b%s%b\n\n' "$DIM" "$PROJECT_DESC" "$R"
  printf '  %bAgent:%b %s\n' "$B" "$R" "$AGENT_CHOICE"
  printf '  %bRepositories:%b\n' "$B" "$R"

  local n=${#REPO_NAMES[@]} i
  for ((i=0; i<n; i++)); do
    local name="${REPO_NAMES[$i]:-?}"
    local rel="${REPO_PATHS[$i]:-}"
    local desc="${REPO_DESCS[$i]:-}"
    local tech="${REPO_TECHS[$i]:-}"
    local abs="${REPO_ABS[$i]:-}"
    if [[ -z "$abs" || ! -d "$abs" ]]; then
      printf '    %b⊘ %-22s %s%b\n' "$DIM" "$name" "$desc" "$R"
    elif [[ "$AGENT_CHOICE" == "omp" && "$rel" == ../* ]]; then
      # sibling path — omp cannot mount extra dirs, so it can't reach ../
      printf '    %b⊘ %-22s unreachable in omp (sibling path)%b\n' "$YEL" "$name" "$R"
    else
      printf '    %b✓%b %b%-22s%b %b%s%b\n' "$GRN" "$R" "$B" "$name" "$R" "$DIM" "$desc" "$R"
    fi
    [[ -n "$tech" ]] && printf '      %btech:%b %s\n' "$DIM" "$R" "$tech"
  done
  echo
}

# ─── marketplace check ─────────────────────────────────────────────────────
# Per-agent hint: claude ships a `claude plugin marketplace` CLI; omp uses its
# /marketplace command. New agents fall through to a generic pointer.
print_marketplace_hint() {
  local action="$1"  # add | update
  local target="wsagency/ws-claude-marketplace"
  [[ "$action" == "update" ]] && target="ws-marketplace"
  case "$AGENT_CHOICE" in
    claude)
      printf '      run: %bclaude plugin marketplace %s %s%b\n' "$B" "$action" "$target" "$R"
      ;;
    omp)
      printf '      run inside omp: %b/marketplace %s %s%b\n' "$B" "$action" "$target" "$R"
      ;;
    *)
      printf '      use the %s marketplace command to %s %s\n' "$AGENT_CHOICE" "$action" "$target"
      ;;
  esac
}

check_marketplace() {
  mkdir -p "$HUB_CACHE"
  local seen_file="$HUB_CACHE/known-marketplace-sha"
  local remote_sha=""
  # Bound the network call so an unreachable remote can't hang the launcher.
  local timeout_cmd=()
  if command -v timeout >/dev/null 2>&1; then timeout_cmd=(timeout 5)
  elif command -v gtimeout >/dev/null 2>&1; then timeout_cmd=(gtimeout 5)
  fi
  remote_sha="$(${timeout_cmd[@]+"${timeout_cmd[@]}"} git ls-remote "$MARKETPLACE_URL" HEAD 2>/dev/null | awk '{print $1}' || true)"
  if [[ -z "$remote_sha" ]]; then
    printf '  %b!%b marketplace check skipped (offline?) — could not reach %b%s%b\n' "$YEL" "$R" "$DIM" "$MARKETPLACE_URL" "$R"
    return
  fi
  local known_sha=""
  [[ -f "$seen_file" ]] && known_sha="$(cat "$seen_file")"
  # The cached SHA is rewritten on every launch, so the messages below are
  # relative to the LAST LAUNCH — not to what the agent has installed.
  if [[ -z "$known_sha" ]]; then
    printf '  %b!%b first launch — if the WS marketplace is not added yet:\n' "$YEL" "$R"
    print_marketplace_hint add
  elif [[ "$known_sha" != "$remote_sha" ]]; then
    printf '  %b↑%b marketplace changed since last launch %b(%s → %s)%b\n' "$YEL" "$R" "$DIM" "${known_sha:0:7}" "${remote_sha:0:7}" "$R"
    print_marketplace_hint update
  else
    printf '  %b✓%b no new marketplace changes since last launch %b(%s)%b\n' "$GRN" "$R" "$DIM" "${remote_sha:0:7}" "$R"
  fi
  echo "$remote_sha" > "$seen_file"
}

# ─── tmux handling ─────────────────────────────────────────────────────────
launch() {
  AGENT_CMD=()
  "agent_cmd_${AGENT_CHOICE}"
  local agent_cmd=("${AGENT_CMD[@]}" "$@")

  if [[ -n "${TMUX:-}" ]]; then
    cd "$HUB_DIR"
    exec "${agent_cmd[@]}"
  fi

  if ! command -v tmux >/dev/null 2>&1; then
    printf '  %btmux not installed — running without persistent session%b\n' "$DIM" "$R"
    cd "$HUB_DIR"
    exec "${agent_cmd[@]}"
  fi

  local session="$TMUX_SESSION"
  if tmux has-session -t "$session" 2>/dev/null; then
    printf '\n  %btmux session "%s" already exists%b\n' "$YEL" "$session" "$R"
    printf '    [%ba%b]ttach  [%bn%b]ew session with suffix  [%bc%b]ancel: ' "$B" "$R" "$B" "$R" "$B" "$R"
    read -r choice
    case "$choice" in
      a|A|"")
        # Attaching resumes the agent already running in the session — args
        # forwarded after `--` cannot be injected into it.
        if [[ $# -gt 0 ]]; then
          printf '  %bnote: forwarded args (%s) are ignored when attaching to an existing session%b\n' "$DIM" "$*" "$R"
        fi
        exec tmux attach -t "$session"
        ;;
      n|N)
        local i=2
        while tmux has-session -t "${session}-${i}" 2>/dev/null; do i=$((i+1)); done
        session="${session}-${i}"
        ;;
      *) printf '  cancelled\n'; exit 0 ;;
    esac
  fi

  local cmd_str
  cmd_str=$(printf '%q ' "${agent_cmd[@]}")
  exec tmux new-session -s "$session" -c "$HUB_DIR" "bash -c $(printf '%q' "$cmd_str")"
}

# ─── main ──────────────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
  animate_intro
fi
if [[ -z "$AGENT_CHOICE" ]]; then
  pick_agent
fi
persist_agent_choice
build_mounts
print_summary
check_marketplace
printf '\n  %bpress ENTER to launch %s…%b ' "$DIM" "$AGENT_CHOICE" "$R"
read -r _
launch ${FORWARD_ARGS[@]+"${FORWARD_ARGS[@]}"}
