project:
  name: __PROJECT_NAME__
  description: __PROJECT_DESCRIPTION__
  session: __PROJECT_NAME__-hub   # tmux session name (default: <name>-hub)
  conventions: 2                 # ws-hub conventions version — machine-managed;
                                 # /ws-hub update migrates older hubs

repos:
  # Convention: each repo lives in its own subfolder of this hub.
  # The hub's .gitignore (managed block) keeps them out of the hub's git.
  #
  # Every repo carries a `type` (ADR 0006):
  #   working — the product's software (default): swept by /ws-docs, indexed
  #             by OpenWiki, analyzed by hub-architect
  #   input   — external deliveries feeding development (client materials,
  #             design assets, data dumps); processed via /ws-hub intake
  #   output  — derived artifacts; add `purpose:` (docs | explained | custom,
  #             max ONE per known purpose per hub)
  #
  # - name: __PROJECT_NAME__-app
  #   path: ./__PROJECT_NAME__-app
  #   url: git@github.com:wsagency/__PROJECT_NAME__-app.git
  #   description: React Native mobile app
  #   tech: react-native, typescript
  #   type: working
