{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "ws-marketplace",
  "description": "WS Agency internal plugins, agents, and tools for Claude Code",
  "owner": {
    "name": "WS Agency",
    "email": "dev@ws.agency"
  },
  "plugins": [
    {
      "name": "docs-agent",
      "description": "Documentation generation using Diataxis framework",
      "version": "1.0.0",
      "source": "./plugins/docs-agent",
      "category": "development",
      "author": {
        "name": "WS Agency"
      },
      "tags": ["documentation", "changelog", "api-docs"]
    },
    {
      "name": "ws-commit-commands",
      "description": "WS git commit and PR workflows",
      "version": "1.0.0",
      "source": "./plugins/ws-commit-commands",
      "category": "development",
      "author": {
        "name": "WS Agency"
      },
      "tags": ["git", "commit", "pr"]
    },
    {
      "name": "ws-jira-enhancer",
      "description": "Transform brief task descriptions into well-structured Jira tickets",
      "version": "1.0.0",
      "source": "./plugins/ws-jira-enhancer",
      "category": "development",
      "author": {
        "name": "WS Agency"
      },
      "tags": ["jira", "ticket", "task-management"]
    },
    {
      "name": "ws-claude-sync",
      "description": "Sync Claude Code contexts, settings, and sessions across machines via GitHub",
      "version": "1.0.0",
      "source": "./plugins/ws-claude-sync",
      "category": "utilities",
      "author": {
        "name": "WS Agency"
      },
      "tags": ["sync", "cross-machine", "github", "settings", "context"]
    },
    {
      "name": "ws-clamp",
      "description": "Move, archive, fix, and manage Claude Code projects while preserving session history",
      "version": "1.4.1",
      "source": "./plugins/ws-clamp",
      "category": "development",
      "author": {
        "name": "WS Agency"
      },
      "tags": ["project-management", "session-history", "migration", "archive", "maintenance"]
    }
  ]
}
